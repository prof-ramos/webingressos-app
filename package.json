{
  "name": "webingressos-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:build && pnpm run test:proxy && pnpm run test:bundle && pnpm run test:e2e",
    "test:build": "NEXT_PUBLIC_SUPABASE_URL= NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY= next build",
    "test:proxy": "node --test tests/proxy-http.test.mjs",
    "test:bundle": "node --test tests/bundle-boundaries.test.mjs",
    "test:e2e": "playwright test",
    "test:db": "npx supabase test db --local supabase/tests/database/foundation_blockers.test.sql",
    "check": "pnpm lint && pnpm typecheck && pnpm build",
    "supabase:push": "npx supabase db push --linked",
    "supabase:types": "npx supabase gen types --linked --lang=typescript > src/lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "shadcn": "^4.16.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
